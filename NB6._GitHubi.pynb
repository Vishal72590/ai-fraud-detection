      " requirements.txt created!\n"
     ]
    }
   ],
   "source": [
    "req = \"\"\"pandas>=1.5.0\n",
    "numpy>=1.23.0\n",
    "matplotlib>=3.6.0\n",
    "seaborn>=0.12.0\n",
    "scikit-learn>=1.2.0\n",
    "xgboost>=1.7.0\n",
    "imbalanced-learn>=0.10.0\n",
    "shap>=0.41.0\n",
    "torch>=2.0.0\n",
    "fastapi>=0.95.0\n",
    "uvicorn>=0.21.0\n",
    "pydantic>=1.10.0\n",
    "joblib>=1.2.0\n",
    "requests>=2.28.0\n",
    "mysql-connector-python>=8.0.0\n",
    "sqlalchemy>=1.4.0\n",
    "pymysql>=1.0.0\n",
    "\"\"\"\n",
    "\n",
    "with open('../requirements.txt', 'w', encoding='utf-8') as f:\n",
    "    f.write(req)\n",
    "print(' requirements.txt created!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "493ebc9a-1be9-463f-a4fe-f6e927bcb55f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Procfile created!\n",
      " runtime.txt created!\n"
     ]
    }
   ],
   "source": [
    "with open('../Procfile', 'w', encoding='utf-8') as f:\n",
    "    f.write('web: uvicorn api.main:app --host 0.0.0.0 --port $PORT')\n",
    "print(' Procfile created!')\n",
    "\n",
    "with open('../runtime.txt', 'w', encoding='utf-8') as f:\n",
    "    f.write('python-3.9.18')\n",
    "print(' runtime.txt created!')\n"
   ]
  },
  {
   "cell_type": "code",
