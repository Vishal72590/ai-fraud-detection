   "source": [
    "import subprocess\n",
    "import os\n",
    "\n",
    "os.chdir('C:\\\\Users\\\\hp')\n",
    "\n",
    "commands = [\n",
    "    # Step 1: Configure git identity (required before commit)\n",
    "    'git config --global user.email \"vishalrathod@5k.com\"',\n",
    "    'git config --global user.name \"vishal72590\"',\n",
    "\n",
    "    # Step 2: Stage all files\n",
    "    \"git add .\",\n",
    "\n",
    "    # Step 3: Check what is staged\n",
    "    \"git status\",\n",
    "\n",
    "    # Step 4: Commit with message\n",
    "    'git commit -m \"AI Fraud Detection - 5 models + FastAPI + MySQL\"',\n",
    "\n",
    "    # Step 5: Push to GitHub\n",
    "    \"git push -u origin main\"\n",
    "]\n",
    "\n",
    "for cmd in commands:\n",
    "    print(f'Running: {cmd}')\n",
    "    result = subprocess.run(\n",
    "        cmd, shell=True,\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if result.returncode == 0:\n",
    "        print(f'   Success')\n",
    "        if result.stdout.strip():\n",
    "            print(f'     {result.stdout.strip()}')\n",
    "    else:\n",
    "        print(f'    {result.stderr.strip()}')\n",
    "    print()"
   ]
  },
