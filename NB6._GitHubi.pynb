     "output_type": "stream",
     "text": [
      "Checking files...\n",
      "\n",
      "    ../README.md\n",
      "    ../requirements.txt\n",
      "    ../.gitignore\n",
      "    ../Procfile\n",
      "    ../runtime.txt\n",
      "    ../api/main.py\n",
      "    ../api/__init__.py\n",
      "\n",
      "Notebooks:\n",
      "     NB5_deployment.ipynb\n",
      "    AI Fraud Detection System_NB1.ipynb\n",
      "    NB2.ipynb\n",
      "    NB3.ipynb\n",
      "    NB4.ipynb\n",
      "\n",
      " All files ready — run Cell 5 to push to GitHub!\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "\n",
    "print('Checking files...\\n')\n",
    "\n",
    "files = [\n",
    "    '../README.md',\n",
    "    '../requirements.txt',\n",
    "    '../.gitignore',\n",
    "    '../Procfile',\n",
    "    '../runtime.txt',\n",
    "    '../api/main.py',\n",
    "    '../api/__init__.py',\n",
    "]\n",
    "\n",
    "all_good = True\n",
    "for f in files:\n",
    "    exists = os.path.exists(f)\n",
    "    status = '' if exists else '❌ MISSING'\n",
    "    print(f'  {status}  {f}')\n",
    "    if not exists:\n",
    "        all_good = False\n",
    "\n",
    "print('\\nNotebooks:')\n",
    "for f in os.listdir('.'):\n",
    "    if f.endswith('.ipynb'):\n",
    "        print(f'    {f}')\n",
    "\n",
    "if all_good:\n",
    "    print('\\n All files ready — run Cell 5 to push to GitHub!')\n",
    "else:\n",
    "    print('\\n  Fix missing files first!')"
   ]
  },
