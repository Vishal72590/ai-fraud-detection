    "\n",
    "files_to_remove = [\n",
    "    'git rm --cached \"NB1.ipynb\"',\n",
    "    'git rm --cached \"NB2.ipynb\"',\n",
    "    'git rm --cached \"NB3.ipynb\"',\n",
    "]\n",
    "\n",
    "for cmd in files_to_remove:\n",
    "    result = subprocess.run(\n",
    "        cmd, shell=True,\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if result.returncode == 0:\n",
    "        print(f'✅  Removed: {cmd.split(\"/\")[-1].replace(chr(34), \"\")}')\n",
    "    else:\n",
    "        print(f'⚠️  {result.stderr.strip()}')\n",
    "\n",
    "# Commit removal\n",
    "print('\\nCommitting removal...')\n",
    "result = subprocess.run(\n",
    "    'git commit -m \"Remove ipynb files - keep only .py scripts\"',\n",
    "    shell=True, capture_output=True, text=True\n",
    ")\n",
    "if result.returncode == 0:\n",
    "    print('✅ Committed!')\n",
    "else:\n",
    "    print(f'⚠️  {result.stderr.strip()}')\n",
    "\n",
