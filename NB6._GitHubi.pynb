   "source": [
    "import subprocess\n",
    "import os\n",
    "\n",
    "GITHUB_USERNAME = \"vishal72590\"   # ← change this!\n",
    "REPO_NAME       = \"ai-fraud-detection\"\n",
    "\n",
    "os.chdir('C:\\\\Users\\\\hp')\n",
    "\n",
    "commands = [\n",
    "    \"git init\",\n",
    "    \"git add .\",\n",
    "    'git commit -m \"AI Fraud Detection - 5 models + FastAPI + MySQL\"',\n",
    "    \"git branch -M main\",\n",
    "    f\"git remote add origin https://github.com/{GITHUB_USERNAME}/{REPO_NAME}.git\",\n",
    "    \"git push -u origin main\"\n",
    "]\n",
    "\n",
    "print('Pushing to GitHub...\\n')\n",
    "for cmd in commands:\n",
    "    print(f'Running: {cmd}')\n",
    "    result = subprocess.run(\n",
    "        cmd, shell=True,\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    if result.returncode == 0:\n",
    "        print(f'   Success')\n",
    "        if result.stdout.strip():\n",
    "            print(f'     {result.stdout.strip()}')\n",
    "    else:\n",
    "        print(f'    {result.stderr.strip()}')\n",
    "    print()\n",
    "\n",
    "print(f' GitHub Done!')\n",
    "print(f'Visit: https://github.com/{GITHUB_USERNAME}/{REPO_NAME}')\n"
   ]
  },
