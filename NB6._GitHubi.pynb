    "import subprocess\n",
    "import os\n",
    "\n",
    "os.chdir('C:\\\\Users\\\\hp')\n",
    "\n",
    "# Step 1: Remove large CSV files from git tracking\n",
    "print('Removing large CSV files from git...')\n",
    "commands_remove = [\n",
    "    'git rm --cached \"AI Fraud Detection System/creditcard.csv\"',\n",
    "    'git rm --cached \"AI Fraud Detection System/creditcard_clean.csv\"',\n",
    "    'git rm --cached \"AI Fraud Detection System/data/creditcard.csv\"',\n",
    "    'git rm --cached \"AI Fraud Detection System/data/creditcard_clean.csv\"',\n",
    "]\n",
    "for cmd in commands_remove:\n",
    "    result = subprocess.run(\n",
    "        cmd, shell=True,\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    # OK if some don't exist\n",
    "    print(f'  {cmd.split(\"/\")[-1]}: done')\n",
    "\n",
    "# Step 2: Update .gitignore to block CSV files\n",
    "print('\\nUpdating .gitignore...')\n",
    "gitignore = \"\"\"# Large data files - download from Kaggle\n",
    "*.csv\n",
    "data/\n",
    "AI Fraud Detection System/data/\n",
    "AI Fraud Detection System/creditcard.csv\n",
    "AI Fraud Detection System/creditcard_clean.csv\n",
    "\n",
    "# Saved model files\n",
    "models/*.pkl\n",
    "models/*.pt\n",
    "AI Fraud Detection System/models/\n",
    "\n",
    "# Python cache\n",
    "__pycache__/\n",
    "*.pyc\n",
    "*.pyo\n",
    ".ipynb_checkpoints/\n",
    "\n",
    "# Virtual environment\n",
    "venv/\n",
    "env/\n",
    ".env\n",
    "\n",
    "# OS files\n",
    ".DS_Store\n",
    "Thumbs.db\n",
    "\"\"\"\n",
    "\n",
    "with open('.gitignore', 'w', encoding='utf-8') as f:\n",
    "    f.write(gitignore)\n",
    "print('✅ .gitignore updated!')\n",
    "\n",
    "# Step 3: Stage everything except CSV\n",
    "print('\\nStaging files...')\n",
    "subprocess.run('git add .gitignore', shell=True)\n",
    "subprocess.run(\n",
    "    'git add \"AI Fraud Detection System/AI Fraud Detection System_NB1.ipynb\"',\n",
    "    shell=True)\n",
    "subprocess.run(\n",
    "    'git add \"AI Fraud Detection System/NB2.ipynb\"',\n",
    "    shell=True)\n",
