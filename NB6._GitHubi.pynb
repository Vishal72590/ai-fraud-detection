    "    shell=True, capture_output=True, text=True\n",
    ")\n",
    "if result.returncode == 0:\n",
    "    print('✅ Done! .ipynb files removed from GitHub!')\n",
    "    print('\\nVisit: https://github.com/vishal72590/ai-fraud-detection')\n",
    "else:\n",
    "    print(f'⚠️  {result.stderr.strip()}')"
