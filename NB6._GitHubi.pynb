    "import subprocess\n",
    "import os\n",
    "\n",
    "os.chdir('C:\\\\Users\\\\hp')\n",
    "\n",
    "# Step 1: Add ONLY your project files specifically\n",
    "# Do NOT use \"git add .\" — it tries to add everything\n",
    "specific_files = [\n",
    "    \"git add README.md\",\n",
    "    \"git add requirements.txt\",\n",
    "    \"git add .gitignore\",\n",
    "    \"git add Procfile\",\n",
    "    \"git add runtime.txt\",\n",
    "    \"git add api/\",\n",
    "    \"git add models/scaler.pkl\",\n",
    "]\n",
    "\n",
    "print('Adding specific files...')\n",
    "for cmd in specific_files:\n",
    "    result = subprocess.run(\n",
    "        cmd, shell=True,\n",
    "        capture_output=True, text=True\n",
    "    )\n",
    "    status = '✅' if result.returncode == 0 else '⚠️'\n",
    "    print(f'  {status}  {cmd}')\n",
    "\n",
    "# Add notebooks\n",
    "notebook_files = [\n",
    "    'AI Fraud Detection System_NB1.ipynb',\n",
    "    'NB2.ipynb',\n",
    "    'NB3.ipynb',\n",
    "    'NB4.ipynb',\n",
    "    'NB5_deployment.ipynb',\n",
    "]\n",
    "for nb in notebook_files:\n",
    "    result = subprocess.run(\n",
    "        f'git add \"{nb}\"',\n",
    "        shell=True, capture_output=True, text=True\n",
    "    )\n",
    "    status = '✅' if result.returncode == 0 else '⚠️'\n",
