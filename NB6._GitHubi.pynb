    ")\n",
    "print(result.stdout)\n",
    "\n",
    "# Step 5: Commit\n",
    "print('Committing...')\n",
    "result = subprocess.run(\n",
    "    'git commit -m \"Add notebooks - exclude large CSV files\"',\n",
