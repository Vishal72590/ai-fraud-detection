   "source": [
    "import subprocess\n",
    "import os\n",
    "\n",
    "FOLDER = 'C:\\\\Users\\\\hp\\\\AI Fraud Detection System'\n",
    "\n",
    "notebooks = {\n",
    "    'NB1.ipynb'           : 'NB1_data_loading_eda.py',\n",
    "    'NB2.ipynb'           : 'NB2_feature_engineering.py',\n",
    "    'NB3.ipynb'           : 'NB3_model_training.py',\n",
    "    'NB4.ipynb'           : 'NB4_stacking_evaluation.py',\n",
    "    ' NB5_deployment.ipynb': 'NB5_fastapi_deployment.py',\n",
    "}\n",
    "\n",
    "print('Converting notebooks to .py files...\\n')\n",
    "for nb, py_name in notebooks.items():\n",
    "    nb_path = os.path.join(FOLDER, nb)\n",
    "\n",
    "    if os.path.exists(nb_path):\n",
    "        result = subprocess.run(\n",
    "            f'jupyter nbconvert --to script \"{nb_path}\"',\n",
    "            shell=True, capture_output=True, text=True\n",
    "        )\n",
    "        if result.returncode == 0:\n",
    "            # Auto generated name\n",
    "            auto_py  = nb_path.replace('.ipynb', '.py')\n",
    "            clean_py = os.path.join(FOLDER, py_name)\n",
    "            if os.path.exists(auto_py):\n",
    "                os.rename(auto_py, clean_py)\n",
    "                size = os.path.getsize(clean_py) / 1024\n",
    "                print(f'✅  {py_name}  ({size:.1f} KB)')\n",
    "        else:\n",
    "            print(f'⚠️  {nb}: {result.stderr.strip()}')\n",
    "    else:\n",
    "        print(f'❌  Not found: {nb_path}')\n",
    "\n",
    "print('\\n✅ All done!')\n",
    "print(f'Check folder: {FOLDER}')"
   ]
  },
